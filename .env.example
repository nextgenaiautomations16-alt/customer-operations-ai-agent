# Copy this file to .env (Copy-Item .env.example .env) and edit the copy.
# Never commit .env. Never put real credentials in .env.example.

# --- Language model (local, free) ---
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
PROMPT_VERSION=v1

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- Knowledge base and thresholds ---
KNOWLEDGE_BASE_DIR=data/knowledge_base
RETRIEVAL_MIN_SCORE=3.0
MIN_CONFIDENCE=0.6

# --- Staff access (development placeholder, NOT real authentication) ---
# Every endpoint except GET /health and POST /cases requires this value in the
# X-API-Key header. Change it. If it is empty, those endpoints refuse to work.
STAFF_API_KEY=change-me-dev-only
